{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/web/src",
  "prefix": "wb",
  "tags": [
    "scope:platform",
    "type:application",
    "runtime:browser"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ng build web"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ng serve web"
      }
    }
  }
}
