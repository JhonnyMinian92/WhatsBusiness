
# Synthetic placeholders only. Inject values into the process/container.
# Never commit .env or real credentials.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://whatsbusiness_app:CHANGE_ME@127.0.0.1:5432/whatsbusiness
MIGRATION_DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/whatsbusiness
DATABASE_POOL_MAX=10
DB_SSL=false
OIDC_ISSUER=http://127.0.0.1:18080/realms/whatsbusiness
OIDC_AUDIENCE=whatsbusiness-web
OIDC_JWKS_URI=http://127.0.0.1:18080/realms/whatsbusiness/protocol/openid-connect/certs

# Signed OIDC step-up assurance. Empty ACR/AMR allowlists fail closed.
# Populate only with values verified in the configured Identity Provider.
STEP_UP_MAX_AGE_SECONDS=300
STEP_UP_ALLOWED_ACR=
STEP_UP_ALLOWED_AMR=

# Tenant-scoped cache (Valkey). Remote endpoints require rediss:// and ACL auth in production.
VALKEY_URL=
VALKEY_CONNECT_TIMEOUT_MS=3000
VALKEY_COMMAND_TIMEOUT_MS=3000
VALKEY_MAX_RESPONSE_BYTES=16777216
VALKEY_MAX_CONNECTIONS=8
VALKEY_ACQUIRE_TIMEOUT_MS=5000

# S3-compatible private object storage. Inject credentials via Secret Manager in production.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_SESSION_TOKEN=
OBJECT_STORAGE_SERVER_SIDE_ENCRYPTION=AES256
OBJECT_STORAGE_KMS_KEY_ID=
OBJECT_STORAGE_TIMEOUT_MS=15000
OBJECT_STORAGE_MAX_OBJECT_BYTES=52428800
