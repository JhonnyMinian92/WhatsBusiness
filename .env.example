NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgresql://whatsbusiness:whatsbusiness@localhost:5432/whatsbusiness
DATABASE_POOL_MAX=20
OIDC_ISSUER=https://identity.example.com/
OIDC_AUDIENCE=whatsbusiness-api
OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
META_APP_ID=
META_APP_SECRET=
META_BUSINESS_LOGIN_CONFIG_ID=
META_OAUTH_REDIRECT_URI=https://api.example.com/v1/meta/oauth/callback
META_GRAPH_API_VERSION=v27.0
META_GRAPH_BASE_URL=https://graph.facebook.com
META_WEBHOOK_VERIFY_TOKEN=
META_WEBHOOK_PUBLIC_URL=https://api.example.com/v1/webhooks/meta
PRIVACY_POLICY_URL=https://example.com/privacy
TERMS_OF_SERVICE_URL=https://example.com/terms
DATA_DELETION_URL=https://example.com/data-deletion
DATA_DELETION_CALLBACK_URL=https://api.example.com/v1/meta/data-deletion
TOKEN_ENCRYPTION_MODE=local
TOKEN_ENCRYPTION_KEY_BASE64=
AWS_REGION=us-east-1
AWS_KMS_KEY_ID=
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
EVENT_BUS_HTTP_URL=
EVENT_BUS_HTTP_TOKEN=
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=info
# Generate a unique key with: openssl rand -base64 32
TELEMETRY_HMAC_KEY_BASE64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
