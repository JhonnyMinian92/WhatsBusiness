{
  "name": "microservices-meta-ecuapp",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "microservices-meta-ecuapp/src",
  "tags": [
    "scope:platform",
    "type:application",
    "runtime:node"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --project microservices-meta-ecuapp/tsconfig.app.json"
      },
      "outputs": [
        "{projectRoot}/dist"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit --project microservices-meta-ecuapp/tsconfig.app.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx --tsconfig microservices-meta-ecuapp/tsconfig.app.json --test microservices-meta-ecuapp/src/jobs/domain/tenant-job-message.spec.ts microservices-meta-ecuapp/src/jobs/domain/tenant-job-retry-policy.spec.ts microservices-meta-ecuapp/src/jobs/application/tenant-job-outbox-dispatcher.spec.ts microservices-meta-ecuapp/src/jobs/application/tenant-job-consumer.spec.ts microservices-meta-ecuapp/src/jobs/application/tenant-job-execution-lease-heartbeat.spec.ts microservices-meta-ecuapp/src/jobs/application/tenant-job-runtime-supervisor.spec.ts microservices-meta-ecuapp/src/jobs/application/tenant-job-runtime.application.spec.ts microservices-meta-ecuapp/src/jobs/infrastructure/bootstrap/tenant-job-runtime.bootstrap.spec.ts microservices-meta-ecuapp/src/jobs/infrastructure/metrics/prometheus-tenant-job-runtime-metrics.spec.ts microservices-meta-ecuapp/src/jobs/infrastructure/postgres/postgres-tenant-job-runtime-metrics.reader.spec.ts microservices-meta-ecuapp/src/jobs/infrastructure/metrics/tenant-job-metrics-http.server.spec.ts microservices-meta-ecuapp/src/jobs/infrastructure/rabbitmq/rabbitmq-tenant-job-publisher.spec.ts microservices-meta-ecuapp/src/jobs/infrastructure/rabbitmq/rabbitmq-tenant-job-consumer.spec.ts microservices-meta-ecuapp/src/jobs/infrastructure/rabbitmq/rabbitmq-transport.integration.spec.ts microservices-meta-ecuapp/src/jobs/infrastructure/postgres/postgres-tenant-job-runtime.integration.spec.ts microservices-meta-ecuapp/src/webhooks/domain/meta-webhook-event.spec.ts microservices-meta-ecuapp/src/webhooks/domain/meta-webhook-signature.spec.ts microservices-meta-ecuapp/src/webhooks/domain/meta-webhook-retry-policy.spec.ts microservices-meta-ecuapp/src/webhooks/application/meta-webhook-ingress.service.spec.ts microservices-meta-ecuapp/src/webhooks/application/meta-webhook-event-processor.spec.ts microservices-meta-ecuapp/src/webhooks/application/meta-webhook-outbox-dispatcher.spec.ts microservices-meta-ecuapp/src/webhooks/infrastructure/crypto/aes-gcm-meta-webhook-payload-protector.spec.ts"
      }
    }
  }
}
