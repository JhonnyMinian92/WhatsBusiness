# API/outbox staging uses the whatsbusiness_app login.
DATABASE_URL=postgresql://whatsbusiness_app:CHANGE_ME@127.0.0.1:5432/whatsbusiness

# Dedicated least-privilege dispatcher and worker identities.
DATABASE_JOB_DISPATCHER_URL=postgresql://whatsbusiness_job_dispatcher:CHANGE_ME@127.0.0.1:5432/whatsbusiness
DATABASE_JOB_WORKER_URL=postgresql://whatsbusiness_job_worker:CHANGE_ME@127.0.0.1:5432/whatsbusiness
MIGRATION_DATABASE_URL=postgresql://whatsbusiness_migrator:CHANGE_ME@127.0.0.1:5432/whatsbusiness
DB_SSL=false
DATABASE_POOL_MAX=10

# RabbitMQ 4.4 quorum queue runtime.
RABBITMQ_URL=amqps://whatsbusiness_jobs:CHANGE_ME@rabbitmq.internal:5671/%2F

# Dedicated RabbitMQ Management HTTP identity (monitoring tag; empty AMQP permissions).
# Use HTTPS (typically 15671) outside loopback. Never reuse RABBITMQ_URL credentials.
RABBITMQ_MANAGEMENT_URL=https://rabbitmq.internal:15671
RABBITMQ_MONITORING_USERNAME=whatsbusiness_metrics
RABBITMQ_MONITORING_PASSWORD=REPLACE_WITH_RANDOM_32_BYTE_SECRET
TENANT_JOB_CONNECTION_NAME=whatsbusiness-job-runtime
TENANT_JOB_CONSUMER_NAME=inbox-worker

# Execution, dispatch and recovery bounds.
TENANT_JOB_CONSUMER_LEASE_SECONDS=120
TENANT_JOB_CONSUMER_PREFETCH=16
TENANT_JOB_HANDLER_TIMEOUT_MS=300000
TENANT_JOB_POLL_INTERVAL_MS=1000
TENANT_JOB_FAILURE_BACKOFF_MS=5000
TENANT_JOB_RECOVERY_BATCH_SIZE=100
TENANT_JOB_STALE_PUBLISH_SECONDS=300
TENANT_JOB_DISPATCH_BATCH_SIZE=100
TENANT_JOB_DISPATCH_LEASE_SECONDS=60
TENANT_JOB_DISPATCH_CONCURRENCY=8

# Retry and reconnect policies.
TENANT_JOB_RETRY_INITIAL_DELAY_MS=1000
TENANT_JOB_RETRY_MAXIMUM_DELAY_MS=300000
TENANT_JOB_RETRY_MULTIPLIER=2
TENANT_JOB_RECONNECT_INITIAL_MS=500
TENANT_JOB_RECONNECT_MAXIMUM_MS=30000
TENANT_JOB_RECONNECT_MULTIPLIER=2
TENANT_JOB_RECONNECT_STABLE_SESSION_MS=30000

# Prometheus exposition endpoint. Loopback is the safe default.
TENANT_JOB_METRICS_HOST=127.0.0.1
TENANT_JOB_METRICS_PORT=9464
TENANT_JOB_METRICS_POLL_INTERVAL_MS=15000
# Required (minimum 32 UTF-8 bytes) when binding outside loopback.
# Supply from Secret Manager; never commit the actual token.
TENANT_JOB_METRICS_BEARER_TOKEN=
